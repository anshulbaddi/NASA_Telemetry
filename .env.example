# Copy to .env and fill in values before deploying to AWS
# Local dev uses docker-compose.yml defaults — this file is for production

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# ── Terraform state (S3 backend) ──────────────────────────────────────────────
TF_STATE_BUCKET=rover-fleet-terraform-state
TF_STATE_KEY=rover-fleet/terraform.tfstate
TF_DYNAMODB_TABLE=rover-fleet-terraform-locks

# ── EKS ───────────────────────────────────────────────────────────────────────
EKS_CLUSTER_NAME=rover-fleet-prod
K8S_NAMESPACE=rover-fleet

# ── MSK (Managed Kafka) ───────────────────────────────────────────────────────
KAFKA_BROKERS=b-1.rover-fleet.xxxxx.c1.kafka.us-east-1.amazonaws.com:9092,b-2.rover-fleet.xxxxx.c1.kafka.us-east-1.amazonaws.com:9092

# ── Service config ────────────────────────────────────────────────────────────
NUM_ROVERS=50
MSGS_PER_ROVER_PER_SEC=60
KAFKA_GROUP_ID=rover-consumer-group

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger-collector.rover-fleet:4317
JAEGER_AGENT_HOST=jaeger-agent.rover-fleet
LOG_LEVEL=info

# ── Container registry ────────────────────────────────────────────────────────
REGISTRY=$(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com
TAG=latest
