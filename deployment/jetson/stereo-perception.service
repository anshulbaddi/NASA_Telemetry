[Unit]
Description=Rover Stereo Perception Pipeline
Documentation=https://github.com/anshulbaddi/NASA_Telemetry
After=network-online.target motor-controller.service
Wants=network-online.target
Requires=motor-controller.service

[Service]
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/rover

# Load rover env file
EnvironmentFile=/home/jetson/rover/.env.rover

ExecStart=/home/jetson/rover/venv/bin/python3 /home/jetson/rover/services/stereo-perception/main.py

# Restart on failure with backoff
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=5

# Give 10s for camera + calibration init before systemd considers it failed
TimeoutStartSec=30s
TimeoutStopSec=10s

# Increase limit for camera file descriptors
LimitNOFILE=65536

# Allow access to /dev/video* for USB cameras and GPIO
SupplementaryGroups=video gpio

StandardOutput=journal
StandardError=journal
SyslogIdentifier=stereo-perception

[Install]
WantedBy=multi-user.target
