# Jetson Nano environment — copy to .env.rover and fill in real values.
# Loaded automatically by scripts/run_rover.py

# ── Network ───────────────────────────────────────────────────────────────────
# LAN IP of the ground station running docker-compose.ground.yml
GROUND_STATION_IP=192.168.1.100

# Kafka on the ground station (exposed on port 29092 for external clients)
KAFKA_BROKERS=192.168.1.100:29092

# gRPC services on the ground station
OBSTACLE_DETECTOR_ADDR=192.168.1.100:50051
PATH_PLANNER_ADDR=192.168.1.100:50054
FDIR_ADDR=192.168.1.100:50053

# ── Rover identity ────────────────────────────────────────────────────────────
ROVER_ID=rover-physical-01

# ── Telemetry mode ────────────────────────────────────────────────────────────
# hardware = publish real Jetson sensor readings
TELEMETRY_MODE=hardware
HARDWARE_RATE_HZ=10

# ── Camera ────────────────────────────────────────────────────────────────────
# oak  = Luxonis OAK-D Lite via DepthAI SDK (USB3) — THIS IS YOUR CAMERA
# csi  = Jetson CSI cameras via nvarguscamerasrc
# usb  = USB stereo camera via V4L2
# file = replay images from data/test_stereo/ (development / CI)
CAMERA_TYPE=oak

# OAK-D Lite resolution — must match a supported preset:
#   640×400 (THE_400_P, recommended — fast, good for 3-5m obstacle range)
#   640×480 (THE_480_P)
#   1280×720 (THE_720_P — more detail, more CPU)
CAMERA_WIDTH=640
CAMERA_HEIGHT=400
CAMERA_FPS=30

# IMPORTANT: run this ONCE before starting the rover service to save
# the OAK's factory calibration to a file:
#   python3 scripts/calibrate_stereo.py oak-calib \
#       --output config/stereo_calibration.yaml \
#       --width 640 --height 400

# ── Calibration ───────────────────────────────────────────────────────────────
CALIBRATION_FILE=/home/jetson/rover/config/stereo_calibration.yaml

# ── Stereo / depth ────────────────────────────────────────────────────────────
PERCEPTION_MODE=stereo
MIN_DEPTH_M=0.25
MAX_DEPTH_M=10.0
USE_WLS_FILTER=false

# ── Motor controller ──────────────────────────────────────────────────────────
# gpio   = Jetson.GPIO PWM (production)
# serial = USB-serial motor board (alternative)
# simulated = no hardware (development)
MOTOR_BACKEND=gpio

MOTOR_GRPC_PORT=50052
MOTOR_METRICS_PORT=9094

# GPIO PWM pins (BCM numbering)
GPIO_LEFT_PWM_PIN=32
GPIO_LEFT_DIR1_PIN=29
GPIO_LEFT_DIR2_PIN=31
GPIO_RIGHT_PWM_PIN=33
GPIO_RIGHT_DIR1_PIN=36
GPIO_RIGHT_DIR2_PIN=38
GPIO_PWM_FREQ_HZ=1000
GPIO_MAX_SPEED=100

# Serial motor board (if MOTOR_BACKEND=serial)
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# ── Safety ────────────────────────────────────────────────────────────────────
EMERGENCY_DISTANCE_M=0.5
STOP_DISTANCE_M=1.5
WARNING_DISTANCE_M=3.0
VISION_TIMEOUT_S=1.0

# ── Metrics ───────────────────────────────────────────────────────────────────
METRICS_PORT=9095

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_SAVE_FRAMES=false
DEBUG_FRAME_DIR=/tmp/rover_debug
LOG_LEVEL=INFO
